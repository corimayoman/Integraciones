{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "database.rules.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "proxy/**",
      "functions/**",
      "tests/**",
      "docs/**",
      ".kiro/**",
      ".vscode/**",
      "scripts/**"
    ],
    "rewrites": [
      {
        "source": "/dc/**",
        "function": { "functionId": "api", "region": "us-central1" }
      },
      {
        "source": "/auth/**",
        "function": { "functionId": "api", "region": "us-central1" }
      },
      {
        "source": "/api/**",
        "function": { "functionId": "api", "region": "us-central1" }
      },
      {
        "source": "/health",
        "function": { "functionId": "api", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [
          { "key": "Content-Type", "value": "application/javascript" }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "database": {
    "rules": "database.rules.json"
  }
}
